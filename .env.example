# Public URL of the site (no trailing slash)
APP_PUBLIC_URL=https://remarketplace.store

# reID Connect (fpreid-connect-sdk) — register this exact redirect URI with reID
REID_CLIENT_ID=
REID_CLIENT_SECRET=            # only if your client_id is a confidential client
REID_REDIRECT_URI=https://remarketplace.store/api/auth/reid/callback
REID_SCOPES=profile wallet:read
# REID_API_URL=https://api.reidentity.net         # override for UAT/staging
# REID_APP_URL=https://fpdigital.reidentity.net   # override consent host

# 32+ random chars — encrypts the session cookie. Generate: openssl rand -base64 48
SESSION_SECRET=

# Optional: POST each demo booking as JSON to this URL (CRM, Slack, Zapier…)
BOOKING_WEBHOOK_URL=
